/* pages/input/input.wxss - 分步引导式 */

page { background: #f5f7fa; }

.container {
  min-height: 100vh;
  padding: 0 30rpx 60rpx;
}

/* 进度条 */
.progress-bar {
  display: flex;
  align-items: center;
  padding: 30rpx 0 10rpx;
  gap: 20rpx;
}
.progress-track {
  flex: 1;
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 10rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #357ABD);
  border-radius: 10rpx;
  transition: width 0.4s ease;
}
.progress-text {
  font-size: 24rpx;
  color: #aaa;
  white-space: nowrap;
}

/* 步骤视图通用 */
.step-view {
  padding-top: 60rpx;
  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateX(30rpx); }
  to   { opacity: 1; transform: translateX(0); }
}

.step-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.step-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}
.step-sub {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

/* 大输入框 */
.big-input {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  font-size: 32rpx;
  color: #333;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  margin-bottom: 36rpx;
}

/* 热门标签 */
.hot-tags { margin-bottom: 48rpx; }
.hot-label {
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 16rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  padding: 14rpx 28rpx;
  background: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #555;
  border: 2rpx solid #e8e8e8;
}
.tag.active {
  background: #e8f0fd;
  color: #4A90E2;
  border-color: #4A90E2;
  font-weight: 600;
}

/* 交通方式卡片 */
.transport-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 36rpx;
}
.transport-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.transport-card.active {
  border-color: #4A90E2;
  background: #e8f0fd;
}
.tc-icon { font-size: 52rpx; margin-bottom: 12rpx; }
.tc-label { font-size: 30rpx; font-weight: 600; color: #222; margin-bottom: 8rpx; }
.tc-desc { font-size: 22rpx; color: #aaa; }

/* 天数选择 */
.days-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 48rpx;
}
.days-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 0;
  text-align: center;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.days-card.active {
  border-color: #4A90E2;
  background: #e8f0fd;
}
.days-num { font-size: 44rpx; font-weight: 700; color: #333; }
.days-card.active .days-num { color: #4A90E2; }
.days-unit { font-size: 22rpx; color: #aaa; }

/* 人员选择 */
.people-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  margin-bottom: 48rpx;
}
.people-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}
.people-name { font-size: 30rpx; font-weight: 600; color: #333; }
.people-sub { font-size: 22rpx; color: #aaa; margin-top: 4rpx; }
.divider { height: 1rpx; background: #f0f0f0; }
.counter {
  display: flex;
  align-items: center;
  gap: 0;
  background: #f0f4fb;
  border-radius: 50rpx;
}
.counter-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #4A90E2;
  font-weight: 700;
}
.counter-num {
  width: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 小孩年龄 */
.age-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.age-tag {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  border: 2rpx solid #e8e8e8;
}
.age-tag.active {
  border-color: #4A90E2;
  background: #e8f0fd;
}
.age-icon { display: block; font-size: 36rpx; margin-bottom: 8rpx; }
.age-label { display: block; font-size: 26rpx; font-weight: 600; color: #333; }
.age-desc { display: block; font-size: 22rpx; color: #aaa; }

/* 预算卡片 */
.budget-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.budget-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #555;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.budget-card.active {
  border-color: #4A90E2;
  background: #e8f0fd;
  color: #4A90E2;
}

/* 自驾详情 */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 16rpx;
}
.option-row { display: flex; gap: 20rpx; margin-bottom: 16rpx; }
.option-btn {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #555;
  border: 2rpx solid #e8e8e8;
}
.option-btn.active {
  border-color: #4A90E2;
  background: #e8f0fd;
  color: #4A90E2;
  font-weight: 600;
}
.switch-label { font-size: 28rpx; color: #555; margin-left: 16rpx; vertical-align: middle; }

/* 按钮 */
.btn-next {
  width: 100%;
  background: linear-gradient(135deg, #4A90E2, #357ABD) !important;
  color: #fff !important;
  border-radius: 50rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  padding: 28rpx 0 !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(74,144,226,0.4) !important;
  margin-top: 20rpx;
}
.btn-back {
  background: #f0f0f0 !important;
  color: #888 !important;
  border-radius: 50rpx !important;
  font-size: 30rpx !important;
  padding: 28rpx 40rpx !important;
  border: none !important;
  margin-top: 20rpx;
}
.btn-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-top: 8rpx;
}
.flex1 { flex: 1; }

/* 确认页 */
.confirm-view { padding-top: 40rpx; animation: fadeIn 0.3s ease; }
.confirm-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 30rpx;
}
.confirm-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  margin-bottom: 30rpx;
}
.confirm-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
}
.confirm-row:last-child { border-bottom: none; }
.ci-icon { font-size: 32rpx; flex-shrink: 0; }
.ci-text { font-size: 28rpx; color: #333; line-height: 1.6; flex: 1; }

.pref-section { margin-bottom: 30rpx; }
.pref-label { font-size: 26rpx; color: #999; margin-bottom: 16rpx; }
.pref-input {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  height: 150rpx;
  line-height: 1.6;
}

.btn-generate {
  flex: 1;
  background: linear-gradient(135deg, #4A90E2, #357ABD) !important;
  color: #fff !important;
  border-radius: 50rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  padding: 28rpx 0 !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(74,144,226,0.4) !important;
  margin-top: 20rpx;
}

/* 辅助 */
.mt16 { margin-top: 16rpx; }
.mt20 { margin-top: 20rpx; }
.mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; }
