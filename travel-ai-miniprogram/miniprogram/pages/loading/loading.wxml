<!-- pages/loading/loading.wxml - AI生成加载页 -->
<view class="loading-container">
  
  <view class="robot">🤖</view>
  
  <view class="title">AI正在为你规划行程...</view>
  
  <view class="steps">
    <view class="step {{stepIndex >= 0 ? 'done' : ''}}">
      <text class="step-icon">{{stepIndex >= 0 ? '✅' : '⏳'}}</text>
      <text class="step-text">分析目的地景点</text>
    </view>
    <view class="step {{stepIndex >= 1 ? 'done' : ''}}">
      <text class="step-icon">{{stepIndex >= 1 ? '✅' : '⏳'}}</text>
      <text class="step-text">匹配亲子友好路线</text>
    </view>
    <view class="step {{stepIndex >= 2 ? 'done' : ''}}">
      <text class="step-icon">{{stepIndex >= 2 ? '✅' : '⏳'}}</text>
      <text class="step-text">规划每日行程</text>
    </view>
    <view class="step {{stepIndex >= 3 ? 'done' : ''}}">
      <text class="step-icon">{{stepIndex >= 3 ? '✅' : '⏳'}}</text>
      <text class="step-text">推荐餐厅与住宿</text>
    </view>
  </view>

  <view class="tip">专属行程定制中，请稍候...</view>

</view>
