/* pages/itinerary/itinerary.wxss */
.container {
  padding: 0 0 120rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* 顶部 */
.header {
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  padding: 40rpx 30rpx 30rpx;
  color: #fff;
}

.trip-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.trip-summary {
  font-size: 26rpx;
  opacity: 0.85;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* 视图切换 */
.view-switch {
  display: flex;
  gap: 16rpx;
}

.switch-btn {
  padding: 12rpx 30rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  background: rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.8);
}

.switch-btn.active {
  background: #fff;
  color: #4A90E2;
  font-weight: 600;
}

/* 天数标签 */
.day-tabs-scroll {
  white-space: nowrap;
  background: #fff;
  padding: 0 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.day-tabs {
  display: inline-flex;
  gap: 0;
}

.day-tab {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #888;
  border-bottom: 4rpx solid transparent;
  white-space: nowrap;
}

.day-tab.active {
  color: #4A90E2;
  border-bottom-color: #4A90E2;
  font-weight: 600;
}

/* 日卡片 */
.day-card {
  padding: 24rpx 30rpx;
}

.day-theme {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.day-num {
  background: #4A90E2;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 50rpx;
}

.day-theme-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 时间轴 */
.timeline {
  position: relative;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 0;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 90rpx;
  flex-shrink: 0;
}

.time-text {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #4A90E2;
  flex-shrink: 0;
}

.timeline-dot.transport { background: #9b59b6; }
.timeline-dot.attraction { background: #e74c3c; }
.timeline-dot.food { background: #e67e22; }
.timeline-dot.hotel { background: #27ae60; }
.timeline-dot.activity { background: #3498db; }

.timeline-line {
  width: 4rpx;
  flex: 1;
  background: #e0e0e0;
  min-height: 40rpx;
  margin: 4rpx 0;
}

/* 活动卡片 */
.activity-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  border-left: 6rpx solid #4A90E2;
}

.activity-card.transport { border-left-color: #9b59b6; }
.activity-card.attraction { border-left-color: #e74c3c; }
.activity-card.food { border-left-color: #e67e22; }
.activity-card.hotel { border-left-color: #27ae60; }
.activity-card.activity { border-left-color: #3498db; }

.activity-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.activity-icon {
  font-size: 32rpx;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.activity-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.activity-footer {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.activity-tips {
  font-size: 24rpx;
  color: #f39c12;
  line-height: 1.5;
}

.activity-cost {
  font-size: 24rpx;
  color: #27ae60;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #4A90E2, #357ABD) !important;
  color: #fff !important;
  border-radius: 50rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  padding: 24rpx 0 !important;
  border: none !important;
}

.btn-secondary {
  flex: 1;
  background: #f0f0f0 !important;
  color: #555 !important;
  border-radius: 50rpx !important;
  font-size: 30rpx !important;
  padding: 24rpx 0 !important;
  border: none !important;
}

/* 地图视图 */
.map-placeholder {
  padding: 40rpx 30rpx;
}

.map-tip {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.map-tip-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 8rpx;
}

.map-tip-sub {
  font-size: 26rpx;
  color: #aaa;
  text-align: center;
  margin-bottom: 40rpx;
}

.map-day-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.map-day-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #4A90E2;
  margin-bottom: 8rpx;
}

.map-day-theme {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
}

.map-spots {
  font-size: 24rpx;
  color: #888;
  line-height: 2;
}
