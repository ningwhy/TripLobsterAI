{
  "meta": {
    "purpose": "SR-OH1/T02 日期感知营业时间解析的离线金标。测试**不联网、不消耗高德配额**。",
    "source": "deliverables/_fx-openhours-probe.mjs / _fx-openhours-probe2.mjs 实测 opentime2 / open_time 原文（已脱敏，不含任何密钥）。",
    "contract": "解析失败 → open/close/lastEntry/closedOnThisDate/openHoursRaw 五字段全 null 且 segments 为空数组；closedOnThisDate 三态（true/false/null），null 绝不当 false。",
    "multiSegmentContract": "单时段 → open/close 有值且 segments 长度 1；多时段 → open/close **强制为 null**，只由 segments 承载。判据是「到达时刻落在 segments 中任一段内」。",
    "weekdayConvention": "1=周一 … 7=周日；expectWeekday 由测试用 Date.UTC 反算并断言，防止 fixture 里写错星期。",
    "diagnostic": "parseOpenTime 额外返回 reason（服务端诊断/探针统计用），不进入客户端 payload。"
  },
  "cases": [
    {
